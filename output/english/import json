import json

# Step 1: Load the JSON file
with open('output/english/August_2025_GyG_OpenAI_Results_English_pg1.json', 'r') as file:
    data = json.load(file)

# Step 2: Filter entries where 'company_1' is not blank
filtered_data = [entry for entry in data if entry.get('company_1')]

with open('output/filtered_ai.json', 'w') as f:
    json.dump(filtered_data, f, indent=2)

# Print the filtered data
print(filtered_data)